{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quality Report Tool",
  "version": "0.1.0",
  "identifier": "com.qualityreport.tool",
  "build": {
    "beforeDevCommand": { "script": "pnpm dev", "cwd": "../ui" },
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": { "script": "pnpm build", "cwd": "../ui" },
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "freezePrototype": true,
      "capabilities": ["main"],
      "pattern": { "use": "isolation", "options": { "dir": "../isolation" } },
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data: asset: http://asset.localhost",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: asset: http://asset.localhost",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost ws://127.0.0.1:1420",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
